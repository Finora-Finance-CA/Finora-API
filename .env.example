# Copy this file to .env and fill in the values (.env is git-ignored).
# Real values are in the team's credential document. Restart the API after changing .env.

# Optional. Port the API listens on (default 4000). The front-end's Vite proxy expects
# 4000. Don't set it on Render: Render sets it.
PORT=4000

# Optional locally (leave unset). Set to production on Render (render.yaml does it),
# which also stops `npm run seed` from running.
# NODE_ENV=

# Required. Supabase Session pooler connection string with the password filled in
# (Supabase: Connect, Session pooler). Render has no IPv6, so never use the Direct
# connection string there. Don't add sslmode; src/db.js turns SSL on itself.
DATABASE_URL=

# Required. Supabase project URL, e.g. https://<project-id>.supabase.co (same as the front-end's VITE_SUPABASE_URL).
SUPABASE_URL=

# Required. Supabase publishable key, sb_publishable_... (same as VITE_SUPABASE_PUBLISHABLE_KEY). Never the secret key.
SUPABASE_PUBLISHABLE_KEY=

# Optional locally, required on Render. Comma-separated sites allowed to call the API
# from a browser (CORS), scheme and host only, no path. Local development doesn't need
# it (the Vite proxy makes requests same-origin), but listing it is harmless.
# On Render, e.g.: https://<your-project>.vercel.app
CLIENT_ORIGIN=http://localhost:5173

# Optional, only for `npm run seed` (never on Render). Sign-in details for the two sample users it creates or reuses.
# Use addresses you control (e.g. you+finora1@gmail.com) and passwords of at least 8 characters.
SEED_USER_1_EMAIL=
SEED_USER_1_PASSWORD=
SEED_USER_2_EMAIL=
SEED_USER_2_PASSWORD=
